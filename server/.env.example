# ==============================================================================
# HET PATEL PORTFOLIO BACKEND - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real production secrets or credentials to version control.

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Server Port
PORT=5000

# Allowed CORS Origins (comma-separated for multiple origins)
# For local dev: http://localhost:3000
# For production: https://het-portfolio-phi.vercel.app,https://yourdomain.com
CORS_ORIGIN=http://localhost:3000

# API Version Prefix
API_PREFIX=/api/v1

# Request Body Limit (e.g. 10kb, 50kb)
REQUEST_SIZE_LIMIT=10kb

# Database Connection URL (Prisma connection string)
# Default for zero-setup local dev: SQLite database file
# Example SQLite: file:./dev.db
# Example PostgreSQL: postgresql://username:password@localhost:5432/het_portfolio?schema=public
DATABASE_URL=file:./dev.db
