# Production Environment Configuration (Backend)
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://het-portfolio-phi.vercel.app
API_PREFIX=/api/v1
REQUEST_SIZE_LIMIT=10kb

# Managed PostgreSQL Connection String (Supabase, Neon, Render, Railway, AWS RDS)
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require"

# Cryptographically strong 32+ character secret for administrative authorization
ADMIN_API_KEY="replace-with-a-secure-random-32-character-secret"

# Reverse proxy hops (1 for Vercel/Render/Railway)
TRUST_PROXY=1
